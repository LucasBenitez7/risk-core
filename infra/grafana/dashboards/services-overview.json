      "title": "HTTP Throughput",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "req/s", "axisPlacement": "auto", "fillOpacity": 20, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineWidth": 1, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "thresholdsStyle": { "mode": "off" } },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "id": 5,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true } },
      "targets": [
        {
          "expr": "sum(rate(django_http_requests_total_by_view_transport_method_total{job=\"policy-service\"}[5m]))",
          "legendFormat": "Policy",
          "refId": "A"
        },
        {
          "expr": "sum(rate(django_http_requests_total_by_view_transport_method_total{job=\"claims-service\"}[5m]))",
          "legendFormat": "Claims",
          "refId": "B"
        },
        {
          "expr": "sum(rate(django_http_requests_total_by_view_transport_method_total{job=\"notification-service\"}[5m]))",
          "legendFormat": "Notification",
          "refId": "C"
        },
        {
          "expr": "sum(rate(django_http_requests_total_by_view_transport_method_total{job=\"audit-service\"}[5m]))",
          "legendFormat": "Audit",
          "refId": "D"
        }
      ],
      "title": "Requests per Second by Service",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 120,
      "panels": [],
      "title": "Error Rate",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "%", "axisPlacement": "auto", "fillOpacity": 20, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineWidth": 1, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "thresholdsStyle": { "mode": "off" } },
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "id": 6,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true } },
      "targets": [
        {
          "expr": "sum(rate(django_http_responses_total_by_status_total{job=\"policy-service\",status=~\"5..\"}[5m])) / sum(rate(django_http_responses_total_by_status_total{job=\"policy-service\"}[5m])) * 100",
          "legendFormat": "Policy",
          "refId": "A"
        },
        {
          "expr": "sum(rate(django_http_responses_total_by_status_total{job=\"claims-service\",status=~\"5..\"}[5m])) / sum(rate(django_http_responses_total_by_status_total{job=\"claims-service\"}[5m])) * 100",
          "legendFormat": "Claims",
          "refId": "B"
        },
        {
          "expr": "sum(rate(django_http_responses_total_by_status_total{job=\"notification-service\",status=~\"5..\"}[5m])) / sum(rate(django_http_responses_total_by_status_total{job=\"notification-service\"}[5m])) * 100",
          "legendFormat": "Notification",
          "refId": "C"
        },
        {
          "expr": "sum(rate(django_http_responses_total_by_status_total{job=\"audit-service\",status=~\"5..\"}[5m])) / sum(rate(django_http_responses_total_by_status_total{job=\"audit-service\"}[5m])) * 100",
          "legendFormat": "Audit",
          "refId": "D"
        }
      ],
      "title": "Error Rate (%) — 5xx Responses",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 130,
      "panels": [],
      "title": "Latency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "seconds", "axisPlacement": "auto", "fillOpacity": 10, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineWidth": 1, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "thresholdsStyle": { "mode": "off" } },
          "unit": "s"
        }
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
      "id": 7,
      "options": { "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom", "showLegend": true } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(django_http_requests_latency_seconds_by_view_method_bucket{job=\"policy-service\"}[5m])) by (le))",
          "legendFormat": "Policy p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(django_http_requests_latency_seconds_by_view_method_bucket{job=\"policy-service\"}[5m])) by (le))",
          "legendFormat": "Policy p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(django_http_requests_latency_seconds_by_view_method_bucket{job=\"policy-service\"}[5m])) by (le))",
          "legendFormat": "Policy p99",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(django_http_requests_latency_seconds_by_view_method_bucket{job=\"claims-service\"}[5m])) by (le))",
          "legendFormat": "Claims p50",
          "refId": "D"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(django_http_requests_latency_seconds_by_view_method_bucket{job=\"claims-service\"}[5m])) by (le))",
          "legendFormat": "Claims p95",
          "refId": "E"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(django_http_requests_latency_seconds_by_view_method_bucket{job=\"claims-service\"}[5m])) by (le))",
          "legendFormat": "Claims p99",
          "refId": "F"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(django_http_requests_latency_seconds_by_view_method_bucket{job=\"notification-service\"}[5m])) by (le))",
          "legendFormat": "Notification p50",
          "refId": "G"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(django_http_requests_latency_seconds_by_view_method_bucket{job=\"notification-service\"}[5m])) by (le))",
          "legendFormat": "Notification p95",
          "refId": "H"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(django_http_requests_latency_seconds_by_view_method_bucket{job=\"notification-service\"}[5m])) by (le))",
          "legendFormat": "Notification p99",
          "refId": "K"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(django_http_requests_latency_seconds_by_view_method_bucket{job=\"audit-service\"}[5m])) by (le))",
          "legendFormat": "Audit p50",
          "refId": "I"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(django_http_requests_latency_seconds_by_view_method_bucket{job=\"audit-service\"}[5m])) by (le))",
          "legendFormat": "Audit p95",
          "refId": "J"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(django_http_requests_latency_seconds_by_view_method_bucket{job=\"audit-service\"}[5m])) by (le))",
          "legendFormat": "Audit p99",
          "refId": "L"
        }
      ],
      "title": "Request Latency (p50/p95/p99) by Service",
