    "lucide-react": "^0.511.0",
    "next": "15.5.9",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "react-hook-form": "^7.57.0",
    "sonner": "^2.0.6",
    "zod": "^3.25.23",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
